{
  "name": "@messages/api",
  "version": "1.0.0",
  "description": "API de Foris: historial, envíos y eventos en tiempo real.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nest build --builder tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "start": "nest start --builder tsc",
    "start:dev": "nest start --builder tsc --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "lint": "eslint src test",
    "pretest": "npm run build:test",
    "test": "node --enable-source-maps --test --test-concurrency=1 dist-test/test/unit/*.test.js dist-test/test/integration/*.test.js"
  },
  "dependencies": {
    "@messages/contracts": "*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.1",
    "typescript": "~6.0.0"
  }
}
