{
  "name": "messages-sonnar",
  "version": "1.0.0",
  "description": "Foris: comunidades y conversación en tiempo real.",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm run build --workspace @messages/api",
    "build:web": "npm run build --workspace @messages/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "prestart": "npm run build",
    "start": "npm run start:prod --workspace @messages/api",
    "dev": "node scripts/dev.ts",
    "dev:api": "node scripts/dev.ts api",
    "dev:web": "node scripts/dev.ts web",
    "lint": "eslint .",
    "pretest": "npm run build:test --workspace @messages/api",
    "test": "c8 node --enable-source-maps --test --test-concurrency=1 apps/api/dist-test/test/unit/*.test.js apps/api/dist-test/test/integration/*.test.js",
    "posttest": "node scripts/normalize-coverage.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "setup": "node scripts/setup.ts",
    "setup:auth": "node scripts/setup-auth.ts",
    "sonar:report": "node --env-file-if-exists=.env scripts/sonar-report.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "c8": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
