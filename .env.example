# Puertos disponibles en tu PC.
APP_PORT=3000
SONAR_PORT=9000

# Aplicacion local y PostgreSQL de mensajes.
HOST=127.0.0.1
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=messages
PGUSER=messages
PGPASSWORD=

# Cambiar antes del primer inicio. El archivo .env local no se sube a Git.
SONAR_DB_PASSWORD=

# Completar despues de generar un token de analisis en SonarQube.
SONAR_TOKEN=
