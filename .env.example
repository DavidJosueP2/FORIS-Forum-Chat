# npm run dev, dev:api y dev:web seleccionan el perfil development.
# .env.development contiene los valores públicos del perfil local.
# .env.development.local permite ajustes personales y permanece excluido de Git.
# Las credenciales comunes se conservan en este .env privado.

# Puertos disponibles en tu PC.
APP_PORT=3000
SONAR_PORT=9000

# Aplicacion local y PostgreSQL de mensajes.
HOST=127.0.0.1
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=messages
PGUSER=messages
PGPASSWORD=

# Cambiar antes del primer inicio. El archivo .env local no se sube a Git.
SONAR_DB_PASSWORD=

# Completar despues de generar un token de analisis en SonarQube.
SONAR_TOKEN=

# Origen de la interfaz. En producción debe ser HTTPS.
APP_URL=http://127.0.0.1:5173
# Solo 1 si hay un único proxy inverso de confianza delante de Nest.
TRUST_PROXY=0
# npm run setup:auth genera este secreto sin mostrarlo ni sustituir uno existente.
AUTH_SECRET=

# Cliente OAuth de tipo Aplicación web; las claves se quedan en el backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP con TLS. 587 usa STARTTLS; 465 usa TLS desde la conexión.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Nombre visible. También se admite el formato Nombre <correo>.
MAIL_FROM="Foris - Chat & Enjoy"
# Opcional si SMTP_USER ya es una dirección de correo autorizada para enviar.
MAIL_FROM_ADDRESS=

# Archivos: development usa local; producción requiere s3.
# .env.development.local permite cambiar estos valores solo para desarrollo.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/uploads
# Se leen únicamente al seleccionar STORAGE_DRIVER=s3.
S3_PROVIDER=r2
S3_REGION=auto
S3_BUCKET=foris-media
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Límites de imágenes y cuotas preventivas de la aplicación, en bytes.
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_IMAGES_PER_POST=3
MEDIA_MAX_IMAGE_PIXELS=16000000
MEDIA_GLOBAL_STORAGE_BYTES=8589934592
MEDIA_USER_STORAGE_BYTES=104857600
MEDIA_UPLOAD_TTL_SECONDS=300
MEDIA_READ_TTL_SECONDS=300
MEDIA_ORPHAN_TTL_HOURS=24
MEDIA_CLEANUP_INTERVAL_SECONDS=60
MEDIA_UPLOADS_PER_HOUR=30

# Videollamada del chat global: habilitada por defecto en desarrollo.
# Producción: CALLS_ENABLED=true exige TURN con secreto compartido (coturn REST).
# Sin definir, producción mantiene esta funcionalidad deshabilitada.
# CALLS_ENABLED=true
CALLS_STUN_URLS=stun:stun.l.google.com:19302
CALLS_TURN_URLS=
CALLS_TURN_SECRET=
