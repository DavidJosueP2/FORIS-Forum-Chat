# npm run dev, dev:api y dev:web seleccionan el perfil development.
# .env.development contiene los valores públicos del perfil local.
# .env.development.local permite ajustes personales y permanece excluido de Git.
# Las credenciales comunes se conservan en este .env privado.

# Puertos disponibles en tu PC.
APP_PORT=3000
SONAR_PORT=9000

# Aplicacion local y PostgreSQL de mensajes.
HOST=127.0.0.1
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=messages
PGUSER=messages
PGPASSWORD=

# Cambiar antes del primer inicio. El archivo .env local no se sube a Git.
SONAR_DB_PASSWORD=

# Completar despues de generar un token de analisis en SonarQube.
SONAR_TOKEN=

# Origen de la interfaz. En producción debe ser HTTPS.
APP_URL=http://127.0.0.1:5173
# Solo 1 si hay un único proxy inverso de confianza delante de Nest.
TRUST_PROXY=0
# npm run setup:auth genera este secreto sin mostrarlo ni sustituir uno existente.
AUTH_SECRET=

# Cliente OAuth de tipo Aplicación web; las claves se quedan en el backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP con TLS. 587 usa STARTTLS; 465 usa TLS desde la conexión.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Nombre visible. También se admite el formato Nombre <correo>.
MAIL_FROM="Foris - Chat & Enjoy"
# Opcional si SMTP_USER ya es una dirección de correo autorizada para enviar.
MAIL_FROM_ADDRESS=
