# Perfil local compartido. Este archivo contiene únicamente valores públicos.
# Los puertos, nombres de base de datos y credenciales se heredan de .env.
# Los ajustes personales pueden definirse en .env.development.local (ignorado por Git).
NODE_ENV=development
HOST=127.0.0.1
PGHOST=127.0.0.1
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/uploads
